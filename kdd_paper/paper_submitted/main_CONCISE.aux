\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces \textbf  {Shippable Prior Distillation.} We amortize expensive offline distillation across users through a three-phase process: (Phase 1) Teacher supervision on calibration datasets generates quality labels from GPT-4o; (Phase 2) Contextual bandit training learns per-model covariance matrices $\mathbf  {A}_m \in \mathbb  {R}^{384 \times 384}$; (Phase 3) Low-rank compression via SVD reduces the prior package to <1MB for distribution. Users download pre-trained priors, eliminating cold-start regret without providing any calibration data. The one-time offline cost (author-borne) is amortized across all deployments.}}{5}{figure.caption.28}\protected@file@percent }
\newlabel{fig:distillation}{{2}{5}{\textbf {Shippable Prior Distillation.} We amortize expensive offline distillation across users through a three-phase process: (Phase 1) Teacher supervision on calibration datasets generates quality labels from GPT-4o; (Phase 2) Contextual bandit training learns per-model covariance matrices $\mathbf {A}_m \in \mathbb {R}^{384 \times 384}$; (Phase 3) Low-rank compression via SVD reduces the prior package to <1MB for distribution. Users download pre-trained priors, eliminating cold-start regret without providing any calibration data. The one-time offline cost (author-borne) is amortized across all deployments}{figure.caption.28}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces \textbf  {Specialist Discovery.} Nova-Lite develops $2\times $ larger weight norms than GPT-4o, occupying orthogonal embedding regions for structured output tasks.}}{5}{figure.caption.30}\protected@file@percent }
\newlabel{fig:specialist_landscape}{{3}{5}{\textbf {Specialist Discovery.} Nova-Lite develops $2\times $ larger weight norms than GPT-4o, occupying orthogonal embedding regions for structured output tasks}{figure.caption.30}{}}
