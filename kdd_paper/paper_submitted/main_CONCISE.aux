\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces \textbf  {BanditGPT System Architecture.} The system accepts user queries, extracts contextual features via sentence encoder, uses shippable priors to warm-start a LinUCB bandit, selects from an 81-model pool via UCB, and updates online via reward feedback. Offline distillation (left annotation) amortizes expensive teacher supervision across all users. Online operation (right annotation) requires zero user-provided calibration data, enabling $O(1)$ model addition without benchmarking.}}{3}{figure.caption.22}\protected@file@percent }
\newlabel{fig:architecture}{{1}{3}{\textbf {BanditGPT System Architecture.} The system accepts user queries, extracts contextual features via sentence encoder, uses shippable priors to warm-start a LinUCB bandit, selects from an 81-model pool via UCB, and updates online via reward feedback. Offline distillation (left annotation) amortizes expensive teacher supervision across all users. Online operation (right annotation) requires zero user-provided calibration data, enabling $O(1)$ model addition without benchmarking}{figure.caption.22}{}}
