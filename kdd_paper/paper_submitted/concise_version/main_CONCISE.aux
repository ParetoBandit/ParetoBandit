\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces \textbf  {Continuous Adaptation Through Online Learning.} The router's empirical beliefs (solid lines) converge to true model performance (dashed lines) within $\sim $200 interactions, starting from zero knowledge. Selected models include gpt-4o-mini (frequent selection), nova-lite-v1 (medium frequency), and gemini-3-pro-preview (rare selection), demonstrating that online learning enables accurate belief formation even for infrequently-explored models.}}{7}{figure.caption.42}\protected@file@percent }
\newlabel{fig:belief_recovery}{{5}{7}{\textbf {Continuous Adaptation Through Online Learning.} The router's empirical beliefs (solid lines) converge to true model performance (dashed lines) within $\sim $200 interactions, starting from zero knowledge. Selected models include gpt-4o-mini (frequent selection), nova-lite-v1 (medium frequency), and gemini-3-pro-preview (rare selection), demonstrating that online learning enables accurate belief formation even for infrequently-explored models}{figure.caption.42}{}}
