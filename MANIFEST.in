# Include license and readme
include LICENSE
include README.md
include CHANGELOG.md
include CONTRIBUTING.md

# Include package data files (now inside banditgpt/)
recursive-include banditgpt/data *.npz *.npy *.jsonl *.json *.txt *.md
graft banditgpt/data

# Include type hints marker
include banditgpt/py.typed

# Exclude large model files (should be downloaded separately)
exclude banditgpt/data/complexity_classifier_final/model.safetensors
exclude banditgpt/data/quality_predictor/*.pt
exclude banditgpt/data/quality_predictor/*.bin

# Exclude test and development files from wheel
prune tests
prune kdd_paper
prune frontend
prune docs
prune .github
