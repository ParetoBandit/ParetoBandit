# =============================================================================
# ParetoBandit Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values you need.
# Only OPENROUTER_API_KEY is required for core routing with the default registry.
# All other variables are optional and context-dependent.

# ---------------------------------------------------------------------------
# LLM Provider API Keys (used by provider adapters and live tests)
# ---------------------------------------------------------------------------
# Required for the default OpenRouter-based registry:
OPENROUTER_API_KEY=

# Optional — only needed if you use the corresponding provider adapter directly:
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GOOGLE_API_KEY=
TOGETHER_API_KEY=
XAI_API_KEY=

# Hugging Face — needed only for data_collection/pca scripts:
HF_TOKEN=

# ---------------------------------------------------------------------------
# Performance Test Tuning (CI / local benchmarking)
# ---------------------------------------------------------------------------
# Set to "1" to enable performance regression tests:
# RUN_PERFORMANCE_TESTS=0
# BANDITGPT_PERF_ROUNDS=50
# BANDITGPT_PERF_WARMUP=5
# BANDITGPT_ROUTE_P95_MS_BUDGET=1.0
# BANDITGPT_UPDATE_P95_MS_BUDGET=2.0
