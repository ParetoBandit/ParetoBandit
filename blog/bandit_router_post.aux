\@writefile{toc}{\contentsline {section}{\numberline {1}Introduction: Why Agents Make Many LLM Calls}{1}{section.1}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {2}Session-Level Routing: The Career Coach}{2}{section.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces A contextual bandit router learns from 5-star user feedback which LLM (small, medium, or large) to use for each career-coaching session type, approaching frontier-level helpfulness at a much lower average cost.}}{2}{figure.caption.1}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:bandit_router}{{1}{2}{A contextual bandit router learns from 5-star user feedback which LLM (small, medium, or large) to use for each career-coaching session type, approaching frontier-level helpfulness at a much lower average cost}{figure.caption.1}{}}
\@writefile{toc}{\contentsline {section}{\numberline {3}Sub-Task Routing: Agentic Systems}{3}{section.3}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces In an agentic workflow, a contextual bandit router dynamically assigns sub-tasks (Planning, Web Search, Data Extraction) to the most cost-effective model, learning from programmatic success metrics rather than direct human feedback.}}{3}{figure.caption.2}\protected@file@percent }
\newlabel{fig:agentic_router}{{2}{3}{In an agentic workflow, a contextual bandit router dynamically assigns sub-tasks (Planning, Web Search, Data Extraction) to the most cost-effective model, learning from programmatic success metrics rather than direct human feedback}{figure.caption.2}{}}
\@writefile{toc}{\contentsline {section}{\numberline {4}Agent Routing: The Multi-Agent Orchestrator}{3}{section.4}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces In a multi-agent architecture, a Contextual Bandit ``Head Coach'' acts as an intelligent triage system, directing ambiguous user queries to the expert agent that maximizes resolution probability while minimizing execution costs.}}{4}{figure.caption.3}\protected@file@percent }
\newlabel{fig:multi_agent}{{3}{4}{In a multi-agent architecture, a Contextual Bandit ``Head Coach'' acts as an intelligent triage system, directing ambiguous user queries to the expert agent that maximizes resolution probability while minimizing execution costs}{figure.caption.3}{}}
\@writefile{toc}{\contentsline {section}{\numberline {5}Hierarchical Routing: Orchestrator vs. Contextual Bandit}{4}{section.5}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Hierarchical Routing Architecture: The Orchestrator handles macro-level functional routing to specialized agents, while the Contextual Bandit resides inside the agents to handle micro-level compute routing across different LLMs for atomic tasks.}}{5}{figure.caption.4}\protected@file@percent }
\newlabel{fig:hierarchical}{{4}{5}{Hierarchical Routing Architecture: The Orchestrator handles macro-level functional routing to specialized agents, while the Contextual Bandit resides inside the agents to handle micro-level compute routing across different LLMs for atomic tasks}{figure.caption.4}{}}
\@writefile{toc}{\contentsline {section}{\numberline {6}Latency-Aware Routing: The Processing Time Dimension}{5}{section.6}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Latency-Aware Routing: The Contextual Bandit dynamically adjusts the penalty for processing time based on whether the user's interaction is synchronous (e.g., live voice chat) or asynchronous (e.g., an offline report generation), directing queries to fast models or heavy reasoning models accordingly.}}{6}{figure.caption.5}\protected@file@percent }
\newlabel{fig:latency}{{5}{6}{Latency-Aware Routing: The Contextual Bandit dynamically adjusts the penalty for processing time based on whether the user's interaction is synchronous (e.g., live voice chat) or asynchronous (e.g., an offline report generation), directing queries to fast models or heavy reasoning models accordingly}{figure.caption.5}{}}
\@writefile{toc}{\contentsline {section}{\numberline {7}Mitigating Router Overhead: Strategic vs. Atomic Routing}{6}{section.7}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Router Overhead Mitigation: By shifting from per-step naive atomic routing (which suffers from cumulative network latency) to upfront workflow policy routing, the agent eliminates routing overhead during repetitive internal loops.}}{7}{figure.caption.6}\protected@file@percent }
\newlabel{fig:overhead}{{6}{7}{Router Overhead Mitigation: By shifting from per-step naive atomic routing (which suffers from cumulative network latency) to upfront workflow policy routing, the agent eliminates routing overhead during repetitive internal loops}{figure.caption.6}{}}
\@writefile{toc}{\contentsline {section}{\numberline {8}Architectural Complexity: Macro vs. Micro Routing}{8}{section.8}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {8.1}Macro-Routing: The Bandit as Orchestrator}{8}{subsection.8.1}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {8.2}Micro-Routing: The Bandit Inside the Agent}{8}{subsection.8.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Macro vs. Micro Routing: As an AI system matures from simple chatbots to complex multi-step agents, the Contextual Bandit is often pushed further down the stack—trading higher system engineering complexity for incredibly dense, programmatic learning signals.}}{9}{figure.caption.7}\protected@file@percent }
\newlabel{fig:comparison}{{7}{9}{Macro vs. Micro Routing: As an AI system matures from simple chatbots to complex multi-step agents, the Contextual Bandit is often pushed further down the stack—trading higher system engineering complexity for incredibly dense, programmatic learning signals}{figure.caption.7}{}}
\@writefile{toc}{\contentsline {section}{\numberline {9}The Business Case for Micro-Routing: Dense Rewards and Margins}{9}{section.9}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {9.1}The Math of Learning: Sparse vs. Dense Rewards}{9}{subsection.9.1}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces Sparse vs. Dense Rewards: Macro-routing relies on single, delayed human feedback signals (sparse), while Micro-routing generates instant, programmatic success/failure signals for every internal step (dense).}}{10}{figure.caption.8}\protected@file@percent }
\newlabel{fig:rewards}{{8}{10}{Sparse vs. Dense Rewards: Macro-routing relies on single, delayed human feedback signals (sparse), while Micro-routing generates instant, programmatic success/failure signals for every internal step (dense)}{figure.caption.8}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {9.2}The Math of Business: Gross Margins}{10}{subsection.9.2}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {10}Conclusion}{10}{section.10}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {A}Worked Example: LLM Calls Inside a Resume Agent}{11}{appendix.A}\protected@file@percent }
\newlabel{app:resume_walkthrough}{{A}{11}{Worked Example: LLM Calls Inside a Resume Agent}{appendix.A}{}}
\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces Anatomy of a single Resume Agent session. Out of 36 total LLM calls, only 2 require the expensive reasoning model. A Contextual Bandit learns this distribution automatically from step-level programmatic feedback (e.g., did the JSON parse? did the keyword comparison pass a coverage threshold?), without any human labeling.}}{11}{table.caption.9}\protected@file@percent }
\newlabel{tab:resume_agent}{{1}{11}{Anatomy of a single Resume Agent session. Out of 36 total LLM calls, only 2 require the expensive reasoning model. A Contextual Bandit learns this distribution automatically from step-level programmatic feedback (e.g., did the JSON parse? did the keyword comparison pass a coverage threshold?), without any human labeling}{table.caption.9}{}}
