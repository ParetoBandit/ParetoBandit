\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces LLM routing evaluation metrics comparing the static cost-penalty baseline and the BudgetPacer ($K{=}3$, 20\nonbreakingspace seeds). \textbf  {cost@$Q$\%\,qual}: cost on the Pareto frontier at $Q$\% of per-prompt oracle quality ($0.963$). \textbf  {qual@$C$\%\,cost}: quality at $C$\% of per-prompt oracle cost ($\$0.00510$/req). \textbf  {Save@95\%}: fractional cost reduction at 95\% of oracle quality relative to the oracle cost. \textbf  {AUCPC}: normalised area under the cost--performance curve, integrated over the model-cost range $[\$2.9{\times }10^{-5},\, \$1.5{\times }10^{-2}]$. \textbf  {Bold} marks the better value in each column. Pareto AUC dominance: Wilcoxon $p = 1.3e-05$. }}{11}{table.caption.21}\protected@file@percent }
\newlabel{tab:routing_metrics}{{3}{11}{LLM routing evaluation metrics comparing the static cost-penalty baseline and the BudgetPacer ($K{=}3$, 20~seeds). \textbf {cost@$Q$\%\,qual}: cost on the Pareto frontier at $Q$\% of per-prompt oracle quality ($0.963$). \textbf {qual@$C$\%\,cost}: quality at $C$\% of per-prompt oracle cost ($\$0.00510$/req). \textbf {Save@95\%}: fractional cost reduction at 95\% of oracle quality relative to the oracle cost. \textbf {AUCPC}: normalised area under the cost--performance curve, integrated over the model-cost range $[\$2.9{\times }10^{-5},\, \$1.5{\times }10^{-2}]$. \textbf {Bold} marks the better value in each column. Pareto AUC dominance: Wilcoxon $p = 1.3e-05$}{table.caption.21}{}}
