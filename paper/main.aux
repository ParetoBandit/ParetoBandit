\newlabel{tab:val_burnin_budget}{{10}{29}{Validation burn-in ablation---budget-constrained regimes (20~seeds, held-out test split, BudgetPacer active, pacer pre-calibrated). $\Delta $ is relative to the Warmup~100\% reference within each regime. \emph {Cost/T} is the mean cost per request as a fraction of the budget target (1.00~=~at target). The burn-in finding holds under budget pressure: within each regime, Warmup~0\% is non-significant vs.\ Warmup~100\%, and cost compliance is consistent across conditions}{table.caption.92}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {11}{\ignorespaces Validation burn-in ablation---unconstrained (K=3 stationary, 20 seeds, 95\% bootstrap CI, held-out test split). Left: cumulative regret on test under varying burn-in fractions (0--100\% of val). All warmup conditions are statistically indistinguishable ($p > 0.15$); the only significant gap is tabula rasa without burn-in ($+10.0\%$, $p < 10^{-5}$). Right: zoom on the first 400 test steps---0\% burn-in (priors only) has the lowest early regret because priors are fully intact.}}{29}{figure.caption.93}\protected@file@percent }
\newlabel{fig:val_burnin_ablation}{{11}{29}{Validation burn-in ablation---unconstrained (K=3 stationary, 20 seeds, 95\% bootstrap CI, held-out test split). Left: cumulative regret on test under varying burn-in fractions (0--100\% of val). All warmup conditions are statistically indistinguishable ($p > 0.15$); the only significant gap is tabula rasa without burn-in ($+10.0\%$, $p < 10^{-5}$). Right: zoom on the first 400 test steps---0\% burn-in (priors only) has the lowest early regret because priors are fully intact}{figure.caption.93}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {A.4}Prior Mismatch Sensitivity (Figures\nonbreakingspace \ref {fig:prior_mismatch_heatmap}--\ref {fig:prior_mismatch_regret})}{29}{subsection.A.4}\protected@file@percent }
\newlabel{appendix:prior_mismatch}{{A.4}{29}{Prior Mismatch Sensitivity (Figures~\ref {fig:prior_mismatch_heatmap}--\ref {fig:prior_mismatch_regret})}{subsection.A.4}{}}
\@writefile{toc}{\contentsline {paragraph}{Design.}{29}{section*.95}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {12}{\ignorespaces Validation burn-in ablation across budget regimes (20 seeds, 95\% bootstrap CI; pacer pre-calibrated, see Appendix\nonbreakingspace \ref {appendix:val_burnin_ablation}). Left: total test regret. Within each regime, Warmup\nonbreakingspace 0\% and Warmup\nonbreakingspace 100\% are statistically indistinguishable, confirming that the burn-in finding holds under the BudgetPacer. The cold-start penalty (Tabula Rasa\nonbreakingspace 0\%) is significant at tight budgets ($+6.7\%$, $p{=}0.002$, survives Bonferroni correction) and present at moderate budgets ($+4.1\%$, $p{=}0.017$, non-significant after Bonferroni). Right: budget compliance (mean cost / target). All conditions stay within $3\%$ of the budget target, confirming consistent pacer behaviour regardless of initialisation.}}{30}{figure.caption.94}\protected@file@percent }
\newlabel{fig:val_burnin_budget}{{12}{30}{Validation burn-in ablation across budget regimes (20 seeds, 95\% bootstrap CI; pacer pre-calibrated, see Appendix~\ref {appendix:val_burnin_ablation}). Left: total test regret. Within each regime, Warmup~0\% and Warmup~100\% are statistically indistinguishable, confirming that the burn-in finding holds under the BudgetPacer. The cold-start penalty (Tabula Rasa~0\%) is significant at tight budgets ($+6.7\%$, $p{=}0.002$, survives Bonferroni correction) and present at moderate budgets ($+4.1\%$, $p{=}0.017$, non-significant after Bonferroni). Right: budget compliance (mean cost / target). All conditions stay within $3\%$ of the budget target, confirming consistent pacer behaviour regardless of initialisation}{figure.caption.94}{}}
\@writefile{toc}{\contentsline {paragraph}{Results.}{30}{section*.96}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {13}{\ignorespaces Total regret across prior quality levels and $n_\mathit  {eff}$ values (K=3 stationary, 20 seeds, held-out test split). The dashed line marks the Tabula Rasa baseline (81.7). Directionally correct priors (Well-calibrated through GSM8K-only) reduce regret at every $n_\mathit  {eff}$; only the Inverted prior---where model rankings are systematically swapped---causes harm, and the damage scales with $n_\mathit  {eff}$.}}{30}{figure.caption.98}\protected@file@percent }
\newlabel{fig:prior_mismatch_heatmap}{{13}{30}{Total regret across prior quality levels and $n_\mathit {eff}$ values (K=3 stationary, 20 seeds, held-out test split). The dashed line marks the Tabula Rasa baseline (81.7). Directionally correct priors (Well-calibrated through GSM8K-only) reduce regret at every $n_\mathit {eff}$; only the Inverted prior---where model rankings are systematically swapped---causes harm, and the damage scales with $n_\mathit {eff}$}{figure.caption.98}{}}
