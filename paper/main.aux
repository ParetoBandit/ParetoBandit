\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces ParetoBandit adaptation dynamics across a three-phase cost scenario: normal pricing $\to $ Gemini price drop (step\nonbreakingspace 609) $\to $ price restored (step\nonbreakingspace 1217). $K{=}3$, 20\nonbreakingspace seeds, 95\% bootstrap CI. \textbf  {(a)}\nonbreakingspace Gemini-Pro selection fraction: when Gemini becomes nearly free, the tight budget surges to ${\sim }70\%$ Gemini adoption while the unconstrained baseline reaches ${\sim }60\%$---the pacer exploits the price drop more aggressively at tight budgets because the residual $\lambda _t$ favours the now-cheapest arm. \textbf  {(b)}\nonbreakingspace Windowed mean reward (trailing 50\nonbreakingspace steps): quality lifts during the price drop track the Gemini adoption in\nonbreakingspace (a), then return to Phase\nonbreakingspace 1 levels after price restoration. \textbf  {(c)}\nonbreakingspace Windowed average cost per request; dotted lines mark budget targets. All three regimes recover budget compliance in Phase\nonbreakingspace 3. See Table\nonbreakingspace \ref {tab:budget_compliance} for quantitative comparisons.}}{14}{figure.caption.30}\protected@file@percent }
\newlabel{fig:adaptation_dynamics}{{4}{14}{ParetoBandit adaptation dynamics across a three-phase cost scenario: normal pricing $\to $ Gemini price drop (step~609) $\to $ price restored (step~1217). $K{=}3$, 20~seeds, 95\% bootstrap CI. \textbf {(a)}~Gemini-Pro selection fraction: when Gemini becomes nearly free, the tight budget surges to ${\sim }70\%$ Gemini adoption while the unconstrained baseline reaches ${\sim }60\%$---the pacer exploits the price drop more aggressively at tight budgets because the residual $\lambda _t$ favours the now-cheapest arm. \textbf {(b)}~Windowed mean reward (trailing 50~steps): quality lifts during the price drop track the Gemini adoption in~(a), then return to Phase~1 levels after price restoration. \textbf {(c)}~Windowed average cost per request; dotted lines mark budget targets. All three regimes recover budget compliance in Phase~3. See Table~\ref {tab:budget_compliance} for quantitative comparisons}{figure.caption.30}{}}
\@writefile{toc}{\contentsline {paragraph}{Adaptation dynamics and the cost--quality tradeoff.}{14}{section*.39}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces ParetoBandit adaptation dynamics under catastrophic model failure: normal $\to $ Mistral failure (reward $\to $ 0.05, cost $\to $ \$0, step\nonbreakingspace 608) $\to $ recovered (step\nonbreakingspace $2{\times }$608). $K{=}3$, 20\nonbreakingspace seeds, 95\% bootstrap CI. \textbf  {(a)}\nonbreakingspace Gemini-Pro selection fraction: the unconstrained baseline freely shifts ${\sim }80\%$ of traffic to expensive Gemini-Pro when Mistral fails, while budget-constrained conditions remain near zero---forced to absorb the failure via cheaper Llama-8B. \textbf  {(b)}\nonbreakingspace Windowed mean reward (trailing 50\nonbreakingspace steps): the Gemini gap in\nonbreakingspace (a) explains the quality gap---unconstrained recovers to ${\sim }0.9$ during failure while constrained conditions dip more because Llama is lower quality. \textbf  {(c)}\nonbreakingspace Windowed average cost per request; dotted lines mark budget targets. All three budget regimes maintain compliance ($0.97$--$1.03\times $) throughout the failure, while unconstrained cost spikes. See Table\nonbreakingspace \ref {tab:failure_response} for quantitative comparisons across algorithms.}}{15}{figure.caption.36}\protected@file@percent }
\newlabel{fig:catastrophic_failure}{{5}{15}{ParetoBandit adaptation dynamics under catastrophic model failure: normal $\to $ Mistral failure (reward $\to $ \cfFailureReward , cost $\to $ \$0, step~\cfPhaseN ) $\to $ recovered (step~$2{\times }$\cfPhaseN ). $K{=}3$, \cfNseeds ~seeds, 95\% bootstrap CI. \textbf {(a)}~Gemini-Pro selection fraction: the unconstrained baseline freely shifts ${\sim }80\%$ of traffic to expensive Gemini-Pro when Mistral fails, while budget-constrained conditions remain near zero---forced to absorb the failure via cheaper Llama-8B. \textbf {(b)}~Windowed mean reward (trailing 50~steps): the Gemini gap in~(a) explains the quality gap---unconstrained recovers to ${\sim }0.9$ during failure while constrained conditions dip more because Llama is lower quality. \textbf {(c)}~Windowed average cost per request; dotted lines mark budget targets. All three budget regimes maintain compliance ($0.97$--$1.03\times $) throughout the failure, while unconstrained cost spikes. See Table~\ref {tab:failure_response} for quantitative comparisons across algorithms}{figure.caption.36}{}}
\@writefile{lot}{\contentsline {table}{\numberline {5}{\ignorespaces Failure response across algorithm variants (Experiment\nonbreakingspace 3, 20\nonbreakingspace seeds). Phase\nonbreakingspace 1: normal operation; Phase\nonbreakingspace 2: Mistral-Large catastrophic failure (reward $\to $ 0.05, cost $\to $ \$0); Phase\nonbreakingspace 3: model restored. \textbf  {Bold} marks budget compliance within 5\% of target. ParetoBandit detects the failure, redistributes traffic, and maintains budget compliance; Fixed Policy keeps routing to the dead model. Phase\nonbreakingspace 2 budget ratio may fall below $1.00\times $ because the failed model's cost drops to \$0.}}{16}{table.caption.37}\protected@file@percent }
\newlabel{tab:failure_response}{{5}{16}{Failure response across algorithm variants (Experiment~3, 20~seeds). Phase~1: normal operation; Phase~2: Mistral-Large catastrophic failure (reward $\to $ 0.05, cost $\to $ \$0); Phase~3: model restored. \textbf {Bold} marks budget compliance within 5\% of target. ParetoBandit detects the failure, redistributes traffic, and maintains budget compliance; Fixed Policy keeps routing to the dead model. Phase~2 budget ratio may fall below $1.00\times $ because the failed model's cost drops to \$0}{table.caption.37}{}}
