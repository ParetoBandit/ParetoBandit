\@writefile{lot}{\contentsline {table}{\numberline {9}{\ignorespaces Validation burn-in ablation---unconstrained regime (20\nonbreakingspace seeds, held-out test split). $\Delta $ is relative to the 100\% burn-in reference. No warmup condition differs significantly from the reference; the only significant gap is tabula rasa without burn-in.}}{27}{table.caption.83}\protected@file@percent }
\newlabel{tab:val_burnin}{{9}{27}{Validation burn-in ablation---unconstrained regime (20~seeds, held-out test split). $\Delta $ is relative to the 100\% burn-in reference. No warmup condition differs significantly from the reference; the only significant gap is tabula rasa without burn-in}{table.caption.83}{}}
\@writefile{lot}{\contentsline {table}{\numberline {10}{\ignorespaces Validation burn-in ablation---budget-constrained regimes (20\nonbreakingspace seeds, held-out test split, BudgetPacer active, pacer pre-calibrated). $\Delta $ is relative to the Warmup\nonbreakingspace 100\% reference within each regime. \emph  {Cost/T} is the mean cost per request as a fraction of the budget target (1.00\nonbreakingspace =\nonbreakingspace at target). The burn-in finding holds under budget pressure: within each regime, Warmup\nonbreakingspace 0\% is non-significant vs.\ Warmup\nonbreakingspace 100\%, and cost compliance is consistent across conditions.}}{27}{table.caption.84}\protected@file@percent }
\newlabel{tab:val_burnin_budget}{{10}{27}{Validation burn-in ablation---budget-constrained regimes (20~seeds, held-out test split, BudgetPacer active, pacer pre-calibrated). $\Delta $ is relative to the Warmup~100\% reference within each regime. \emph {Cost/T} is the mean cost per request as a fraction of the budget target (1.00~=~at target). The burn-in finding holds under budget pressure: within each regime, Warmup~0\% is non-significant vs.\ Warmup~100\%, and cost compliance is consistent across conditions}{table.caption.84}{}}
\@writefile{toc}{\contentsline {paragraph}{Implication.}{27}{section*.82}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {10}{\ignorespaces Validation burn-in ablation---unconstrained (K=3 stationary, 20 seeds, 95\% bootstrap CI, held-out test split). Left: cumulative regret on test under varying burn-in fractions (0--100\% of val). All warmup conditions are statistically indistinguishable ($p > 0.15$); the only significant gap is tabula rasa without burn-in ($+10.0\%$, $p < 10^{-5}$). Right: zoom on the first 400 test steps---0\% burn-in (priors only) has the lowest early regret because priors are fully intact.}}{28}{figure.caption.85}\protected@file@percent }
\newlabel{fig:val_burnin_ablation}{{10}{28}{Validation burn-in ablation---unconstrained (K=3 stationary, 20 seeds, 95\% bootstrap CI, held-out test split). Left: cumulative regret on test under varying burn-in fractions (0--100\% of val). All warmup conditions are statistically indistinguishable ($p > 0.15$); the only significant gap is tabula rasa without burn-in ($+10.0\%$, $p < 10^{-5}$). Right: zoom on the first 400 test steps---0\% burn-in (priors only) has the lowest early regret because priors are fully intact}{figure.caption.85}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {11}{\ignorespaces Validation burn-in ablation across budget regimes (20 seeds, 95\% bootstrap CI; pacer pre-calibrated, see Appendix\nonbreakingspace \ref {appendix:val_burnin_ablation}). Left: total test regret. Within each regime, Warmup\nonbreakingspace 0\% and Warmup\nonbreakingspace 100\% are statistically indistinguishable, confirming that the burn-in finding holds under the BudgetPacer. The cold-start penalty (Tabula Rasa\nonbreakingspace 0\%) is significant at tight budgets ($+6.7\%$, $p{=}0.002$, survives Bonferroni correction) and present at moderate budgets ($+4.1\%$, $p{=}0.017$, non-significant after Bonferroni). Right: budget compliance (mean cost / target). All conditions stay within $3\%$ of the budget target, confirming consistent pacer behaviour regardless of initialisation.}}{28}{figure.caption.86}\protected@file@percent }
\newlabel{fig:val_burnin_budget}{{11}{28}{Validation burn-in ablation across budget regimes (20 seeds, 95\% bootstrap CI; pacer pre-calibrated, see Appendix~\ref {appendix:val_burnin_ablation}). Left: total test regret. Within each regime, Warmup~0\% and Warmup~100\% are statistically indistinguishable, confirming that the burn-in finding holds under the BudgetPacer. The cold-start penalty (Tabula Rasa~0\%) is significant at tight budgets ($+6.7\%$, $p{=}0.002$, survives Bonferroni correction) and present at moderate budgets ($+4.1\%$, $p{=}0.017$, non-significant after Bonferroni). Right: budget compliance (mean cost / target). All conditions stay within $3\%$ of the budget target, confirming consistent pacer behaviour regardless of initialisation}{figure.caption.86}{}}
