\newlabel{fig:model_onboarding}{{10}{23}{\input {../experiments/appendix/model_onboarding/figure_caption.tex}}{figure.caption.73}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {11}{\ignorespaces Uncertainty evolution during model onboarding (moderate budget, 20 seeds, 95\% bootstrap CI). $\mathrm  {tr}(A_a^{-1})$ measures total uncertainty per arm: higher values indicate less information and larger exploration bonuses. Warm-started arms (Llama-8B, Mistral-Large) maintain low, stable uncertainty (${\sim }0.6$--$2$) throughout both phases. Cold-started Flash appears at the Phase\nonbreakingspace 2 boundary with $\mathrm  {tr}(A_a^{-1}) = d/\lambda = 26$ (the isotropic prior $A = \lambda I$) and converges to the incumbents' level within ${\sim }300$ steps as LinUCB's exploration bonus drives traffic to it. Gemini-Pro exhibits rising, oscillatory uncertainty because it is rarely selected under budget pressure---geometric forgetting erases its accumulated information faster than new observations replenish it, illustrating the forgetting--budget pacer feedback loop described in Section\nonbreakingspace \ref {sec:methodology}.}}{23}{figure.caption.74}\protected@file@percent }
\newlabel{fig:uncertainty_evolution}{{11}{23}{Uncertainty evolution during model onboarding (moderate budget, 20 seeds, 95\% bootstrap CI). $\mathrm {tr}(A_a^{-1})$ measures total uncertainty per arm: higher values indicate less information and larger exploration bonuses. Warm-started arms (Llama-8B, Mistral-Large) maintain low, stable uncertainty (${\sim }0.6$--$2$) throughout both phases. Cold-started Flash appears at the Phase~2 boundary with $\mathrm {tr}(A_a^{-1}) = d/\lambda = 26$ (the isotropic prior $A = \lambda I$) and converges to the incumbents' level within ${\sim }300$ steps as LinUCB's exploration bonus drives traffic to it. Gemini-Pro exhibits rising, oscillatory uncertainty because it is rarely selected under budget pressure---geometric forgetting erases its accumulated information faster than new observations replenish it, illustrating the forgetting--budget pacer feedback loop described in Section~\ref {sec:methodology}}{figure.caption.74}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {12}{\ignorespaces Cost heuristic validation. Left: violin plots of actual per-request costs (log scale) for each model, ordered by the static heuristic $\tilde  {c}_a$. Right: fraction of prompts where each pairwise cost ordering matches the heuristic ranking. Top row: $K{=}3$ portfolio; bottom row: $K{=}4$ with Gemini-Flash added.}}{23}{figure.caption.80}\protected@file@percent }
\newlabel{fig:cost_heuristic}{{12}{23}{Cost heuristic validation. Left: violin plots of actual per-request costs (log scale) for each model, ordered by the static heuristic $\tilde {c}_a$. Right: fraction of prompts where each pairwise cost ordering matches the heuristic ranking. Top row: $K{=}3$ portfolio; bottom row: $K{=}4$ with Gemini-Flash added}{figure.caption.80}{}}
