\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces ParetoBandit dual-variable dynamics under a mid-stream Gemini price drop (step\nonbreakingspace 912; 50\nonbreakingspace seeds, 95\% bootstrap CI). \textbf  {(a)}\nonbreakingspace The dual variable $\lambda _t$ reveals qualitatively distinct responses: at tight budget, $\lambda _t$ \emph  {rises} because costs still exceed the target (binding constraint); at moderate/loose budgets, $\lambda _t$ decays to zero as post-drop costs fall well below target (slack constraint). \textbf  {(b)}\nonbreakingspace Gemini selection fraction mirrors the dual signal---tight budget drives $86\%$ Gemini adoption via cost-penalty concentration; moderate/loose converge toward the unconstrained baseline (dash-dot). \textbf  {(c)}\nonbreakingspace Running average cost per request; dotted lines mark budget targets. All three regimes exhibit the correct Lagrangian response. Quantitative compliance comparisons with baselines are in Table\nonbreakingspace \ref {tab:budget_compliance}.}}{13}{figure.caption.29}\protected@file@percent }
\newlabel{fig:adaptation_dynamics}{{5}{13}{ParetoBandit dual-variable dynamics under a mid-stream Gemini price drop (step~912; 50~seeds, 95\% bootstrap CI). \textbf {(a)}~The dual variable $\lambda _t$ reveals qualitatively distinct responses: at tight budget, $\lambda _t$ \emph {rises} because costs still exceed the target (binding constraint); at moderate/loose budgets, $\lambda _t$ decays to zero as post-drop costs fall well below target (slack constraint). \textbf {(b)}~Gemini selection fraction mirrors the dual signal---tight budget drives $86\%$ Gemini adoption via cost-penalty concentration; moderate/loose converge toward the unconstrained baseline (dash-dot). \textbf {(c)}~Running average cost per request; dotted lines mark budget targets. All three regimes exhibit the correct Lagrangian response. Quantitative compliance comparisons with baselines are in Table~\ref {tab:budget_compliance}}{figure.caption.29}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Efficiency--adaptability tradeoff for ParetoBandit ($K{=}3$, PCA-25). Each point is one ($\alpha $, $n_\mathit  {eff}$, $\gamma $) configuration; colour encodes $\gamma $. The green band marks the $\epsilon $-feasible region ($\geq $99.75\% of best AUC); 98 of 144 configurations pass. The black star is the $\epsilon $-constraint winner; the red \textbf  {X} is the AUC-only winner ($\gamma {=}1.0$), which suffers the highest Phase-2 regret.}}{13}{figure.caption.35}\protected@file@percent }
\newlabel{fig:epsilon_tradeoff}{{6}{13}{Efficiency--adaptability tradeoff for ParetoBandit ($K{=}3$, PCA-25). Each point is one ($\alpha $, $n_\mathit {eff}$, $\gamma $) configuration; colour encodes $\gamma $. The green band marks the $\epsilon $-feasible region ($\geq $99.75\% of best AUC); 98 of 144 configurations pass. The black star is the $\epsilon $-constraint winner; the red \textbf {X} is the AUC-only winner ($\gamma {=}1.0$), which suffers the highest Phase-2 regret}{figure.caption.35}{}}
