\@writefile{lof}{\contentsline {figure}{\numberline {12}{\ignorespaces Total regret across prior quality levels and $n_\mathit  {eff}$ values (K=3 stationary, 20 seeds, held-out test split). The dashed line marks the Tabula Rasa baseline (81.7). Directionally correct priors (Well-calibrated through GSM8K-only) reduce regret at every $n_\mathit  {eff}$; only the Inverted prior---where model rankings are systematically swapped---causes harm, and the damage scales with $n_\mathit  {eff}$.}}{29}{figure.caption.90}\protected@file@percent }
\newlabel{fig:prior_mismatch_heatmap}{{12}{29}{Total regret across prior quality levels and $n_\mathit {eff}$ values (K=3 stationary, 20 seeds, held-out test split). The dashed line marks the Tabula Rasa baseline (81.7). Directionally correct priors (Well-calibrated through GSM8K-only) reduce regret at every $n_\mathit {eff}$; only the Inverted prior---where model rankings are systematically swapped---causes harm, and the damage scales with $n_\mathit {eff}$}{figure.caption.90}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {13}{\ignorespaces Cumulative regret curves for selected prior-quality conditions at $n_\mathit  {eff}{=}1{,}000$ (K=3 stationary, 20 seeds, 95\% bootstrap CI). Well-calibrated and domain-mismatched priors separate from Tabula Rasa within the first 200 steps and maintain the advantage throughout. The Inverted prior accumulates excess regret early as the router confidently routes to the wrong model, requiring hundreds of steps to partially recover.}}{29}{figure.caption.91}\protected@file@percent }
\newlabel{fig:prior_mismatch_regret}{{13}{29}{Cumulative regret curves for selected prior-quality conditions at $n_\mathit {eff}{=}1{,}000$ (K=3 stationary, 20 seeds, 95\% bootstrap CI). Well-calibrated and domain-mismatched priors separate from Tabula Rasa within the first 200 steps and maintain the advantage throughout. The Inverted prior accumulates excess regret early as the router confidently routes to the wrong model, requiring hundreds of steps to partially recover}{figure.caption.91}{}}
