\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Budget pacing under cost drift (50\nonbreakingspace seeds, $\pm $1\,SE shading). At step\nonbreakingspace 912, Gemini-2.5-Pro's price drops to near-zero. \textbf  {Top row:} BanditGPT adaptation mechanics. At moderate/loose budgets, $\lambda _t$ decays to zero (slack constraint) and Gemini rises to ${\sim }47$--$48\%$. At the tight budget, $\lambda _t$ \emph  {rises} (binding constraint) and Gemini surges to $87\%$. \textbf  {Bottom row:} All-condition budget compliance at each budget level. BanditGPT (solid) is the only condition that tracks the target (black dotted) across both phases; the Recalibrated Bandit (dash-dot) re-tunes $\lambda _s$ at Phase\nonbreakingspace 2 but inherits Phase\nonbreakingspace 1 non-compliance.}}{9}{figure.caption.20}\protected@file@percent }
\newlabel{fig:adaptation_dynamics}{{5}{9}{Budget pacing under cost drift (50~seeds, $\pm $1\,SE shading). At step~912, Gemini-2.5-Pro's price drops to near-zero. \textbf {Top row:} BanditGPT adaptation mechanics. At moderate/loose budgets, $\lambda _t$ decays to zero (slack constraint) and Gemini rises to ${\sim }47$--$48\%$. At the tight budget, $\lambda _t$ \emph {rises} (binding constraint) and Gemini surges to $87\%$. \textbf {Bottom row:} All-condition budget compliance at each budget level. BanditGPT (solid) is the only condition that tracks the target (black dotted) across both phases; the Recalibrated Bandit (dash-dot) re-tunes $\lambda _s$ at Phase~2 but inherits Phase~1 non-compliance}{figure.caption.20}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Efficiency--adaptability tradeoff for BanditGPT ($K{=}3$, PCA-25). Each point is one ($\alpha $, $n_\mathit  {eff}$, $\gamma $) configuration; colour encodes $\gamma $. The green band marks the $\epsilon $-feasible region ($\geq $95\% of best AUC). The black star is the $\epsilon $-constraint winner; the red \textbf  {X} is the AUC-only winner ($\gamma {=}1.0$), which suffers the highest Phase-2 regret.}}{9}{figure.caption.25}\protected@file@percent }
\newlabel{fig:epsilon_tradeoff}{{6}{9}{Efficiency--adaptability tradeoff for BanditGPT ($K{=}3$, PCA-25). Each point is one ($\alpha $, $n_\mathit {eff}$, $\gamma $) configuration; colour encodes $\gamma $. The green band marks the $\epsilon $-feasible region ($\geq $95\% of best AUC). The black star is the $\epsilon $-constraint winner; the red \textbf {X} is the AUC-only winner ($\gamma {=}1.0$), which suffers the highest Phase-2 regret}{figure.caption.25}{}}
