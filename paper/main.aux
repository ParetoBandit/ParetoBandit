\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces ParetoBandit System Architecture. The system cleanly separates synchronous inference (blue) from asynchronous feedback (orange, color-blind friendly). During inference, the \texttt  {BudgetPacer} dynamically applies a dual cost penalty ($\lambda _t$) to the LinUCB scores to enforce the budget constraint $B$. As feedback arrives asynchronously, the reward $r_t$ updates the router's statistics via geometric forgetting ($\gamma $), while the exact cost $c_t$ updates the pacer's dual variable ($\lambda _{t+1}$) via an EMA smoother.}}{7}{figure.caption.7}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:architecture}{{1}{7}{ParetoBandit System Architecture. The system cleanly separates synchronous inference (blue) from asynchronous feedback (orange, color-blind friendly). During inference, the \texttt {BudgetPacer} dynamically applies a dual cost penalty ($\lambda _t$) to the LinUCB scores to enforce the budget constraint $B$. As feedback arrives asynchronously, the reward $r_t$ updates the router's statistics via geometric forgetting ($\gamma $), while the exact cost $c_t$ updates the pacer's dual variable ($\lambda _{t+1}$) via an EMA smoother}{figure.caption.7}{}}
\newlabel{eq:cost_norm}{{4}{7}{Primal-Dual Budget Pacing}{equation.4}{}}
